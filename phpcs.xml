<?xml version="1.0"?>
<ruleset name="BimBeau Privacy Analytics"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

	<description>
		WordPress-style checks for BimBeau Privacy Analytics: WordPress-Extra, every WordPress.Security and
		WordPress.DB sniff, and PHPCompatibilityWP (PHP 7.4 and later). Purely cosmetic sniffs (whitespace,
		indentation, alignment, brace placement, array syntax, Yoda conditions, file naming) are disabled so
		the report only lists actionable problems. The existing code has not been reformatted to this
		standard: run phpcs on the files you change, and never reformat whole files with phpcbf.

		Requirements: PHP_CodeSniffer 3.13 or later with WordPress-Coding-Standards 3.x, PHPCSUtils,
		PHPCSExtra and PHPCompatibilityWP registered in its installed_paths.
	</description>

	<!-- Default scan targets when phpcs runs without file arguments: the shipped plugin PHP. -->
	<file>bimbeau-privacy-analytics.php</file>
	<file>admin</file>
	<file>db</file>
	<file>front</file>
	<file>includes</file>
	<file>rest</file>

	<!-- Generated, vendored or third-party code is never checked, even when passed explicitly. -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/includes/maxmind-db/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/phpunit/fixtures/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<!-- Show sniff codes so that a false positive can be silenced precisely. -->
	<arg value="s"/>

	<!-- Warnings are advisory: only errors make phpcs exit with a non-zero status. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra">
		<!-- Whitespace, indentation and alignment: the code base mixes tabs and spaces and does not pad
		     parentheses. Formatting is not enforced. -->
		<exclude name="Generic.WhiteSpace"/>
		<exclude name="Squiz.WhiteSpace"/>
		<exclude name="WordPress.WhiteSpace"/>
		<exclude name="Universal.WhiteSpace"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.DisallowMultipleStatements"/>
		<exclude name="WordPress.Arrays"/>
		<exclude name="NormalizedArrays.Arrays"/>

		<!-- Brace placement and control structure layout. -->
		<exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>
		<exclude name="Generic.Classes.OpeningBraceSameLine"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
		<exclude name="PSR2.Classes.ClassDeclaration"/>
		<exclude name="PSR2.Methods.FunctionClosingBrace"/>
		<exclude name="PSR2.Files.EndFileNewline"/>

		<!-- Syntax preferences without behavioural impact. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
		<exclude name="Squiz.Operators.IncrementDecrementUsage"/>
		<exclude name="Squiz.Strings.DoubleQuoteUsage"/>
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!-- File layout and naming: renaming files, functions or parameters would break the public
		     PHP API of the plugin. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<!-- Properties of objects the plugin does not own (DOMDocument, MaxMind records, ...). -->
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>

	<!-- Every security and database sniff, including the ones WordPress-Extra leaves out
	     (WordPress.DB.DirectDatabaseQuery reports warnings only). -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>

	<!-- PHP 7.4 is the minimum supported version (see testVersion above). -->
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bimbeau-privacy-analytics"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bbpa"/>
			</property>
		</properties>
		<!-- The PHP 8 polyfills deliberately declare the unprefixed native function names. -->
		<exclude-pattern>*/includes/php74-polyfills.php</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test code talks to the database directly and fakes requests and globals on purpose. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>

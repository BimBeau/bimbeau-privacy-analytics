#: src/admin/panels/SettingsPanel.js
msgid "What is a CMP?"
msgstr "Hvad er en CMP?"

#: src/admin/panels/SettingsPanel.js
msgid "A CMP manages cookie consent on your website. It shows the cookie banner, stores visitor choices, and allows or blocks analytics scripts based on consent."
msgstr "En CMP håndterer cookiesamtykke på dit websted. Den viser cookiebanneret, gemmer besøgendes valg og tillader eller blokerer analysescripts baseret på samtykke."

#: src/admin/panels/SettingsPanel.js
msgid "Examples:"
msgstr "Eksempler:"

#: src/admin/panels/SettingsPanel.js
msgid "In your CMP, block the BimBeau Privacy Analytics advanced stats script until the Statistics or Analytics purpose is accepted."
msgstr "I din CMP skal du blokere BimBeau Privacy Analytics-scriptet til avanceret statistik, indtil formålet Statistik eller Analyse er accepteret."

#: src/admin/panels/SettingsPanel.js
msgid "Advanced stats are disabled. BimBeau Privacy Analytics will only use essential stats."
msgstr "Avanceret statistik er deaktiveret. BimBeau Privacy Analytics bruger kun essentiel statistik."

#: src/admin/panels/SettingsPanel.js
msgid "Respect DNT / GPC"
msgstr "Respektér DNT / GPC"

#: src/admin/panels/SettingsPanel.js
msgid "Stop measurement when the visitor’s browser sends a Do Not Track or Global Privacy Control signal."
msgstr "Stop måling, når den besøgendes browser sender et Do Not Track- eller Global Privacy Control-signal."

#: src/admin/panels/SettingsPanel.js
msgid "Visit measurement"
msgstr "Besøgsmåling"

#: src/admin/panels/SettingsPanel.js
msgid "Defines how long visitor activity can remain grouped under the same visitor row before a new row is started after inactivity."
msgstr "Definerer, hvor længe besøgsaktivitet kan forblive grupperet under den samme besøgsrække, før en ny række startes efter inaktivitet."

#: src/admin/panels/SettingsPanel.js
msgid "Visitor activity window"
msgstr "Aktivitetsvindue for besøgende"

#: src/admin/panels/SettingsPanel.js
msgid "Defines how long activity from the same visitor can remain grouped into one visitor row. After this period of inactivity, BimBeau Privacy Analytics starts a new visitor row. Range: 300 to 86400 seconds (5 minutes to 24 hours)."
msgstr "Definerer, hvor længe aktivitet fra den samme besøgende kan forblive grupperet i én besøgsrække. Efter denne periode med inaktivitet starter BimBeau Privacy Analytics en ny besøgsrække. Interval: 300 til 86400 sekunder (5 minutter til 24 timer)."

#: src/admin/panels/SettingsPanel.js
msgid "URLs & campaigns"
msgstr "URL'er og kampagner"

#: src/admin/panels/SettingsPanel.js
msgid "Control URL cleanup behavior and keep only campaign query parameters that should remain available for attribution."
msgstr "Styr URL-oprydning, og behold kun de kampagneparametre, der skal forblive tilgængelige til attribuering."

#: src/admin/panels/SettingsPanel.js
msgid "Clean URL query parameters"
msgstr "Rens URL-forespørgselsparametre"

#: src/admin/panels/SettingsPanel.js
msgid "Remove query parameters from tracked URLs."
msgstr "Fjern forespørgselsparametre fra sporede URL'er."

#: src/admin/panels/SettingsPanel.js
msgid "Allowed query parameters"
msgstr "Tilladte forespørgselsparametre"

#: src/admin/panels/SettingsPanel.js
msgid "Comma-separated list of allowed query keys (used for URL tracking and UTM aggregation)."
msgstr "Kommasepareret liste over tilladte forespørgselsnøgler (bruges til URL-sporing og UTM-aggregering)."

#: src/admin/panels/SettingsPanel.js
msgid "Data retention"
msgstr "Dataopbevaring"

#: src/admin/panels/SettingsPanel.js
msgid "Choose how long to keep temporary detailed events, report details, and long-term totals, then how often cleanup runs."
msgstr "Choose how long to keep temporary detailed events, report details, and long-term totals, then how often cleanup runs."

#: src/admin/panels/SettingsPanel.js
msgid "Temporary detailed events retention (days)"
msgstr "Opbevaring af midlertidige detaljerede hændelser (dage)"

#: src/admin/panels/SettingsPanel.js
msgid "Used mainly for real-time and diagnostics. Not related to Debug mode."
msgstr "Used mainly for real-time and diagnostics. Not related to Debug mode."

#: src/admin/panels/SettingsPanel.js
msgid "Report details retention"
msgstr "Opbevaring af rapportdetaljer"

#: src/admin/panels/SettingsPanel.js
msgid "Keeps detailed report dimensions such as pages, referrers, countries, devices, and visitor details."
msgstr "Keeps detailed report dimensions such as pages, referrers, countries, devices, and visitor details."

#: src/admin/panels/SettingsPanel.js
msgid "Long-term totals retention"
msgstr "Opbevaring af langsigtede totaler"

#: src/admin/panels/SettingsPanel.js
msgid "Keeps anonymous daily totals for dashboard KPIs and the page views/visitors chart after report details expire."
msgstr "Keeps anonymous daily totals for dashboard KPIs and the page views/visitors chart after report details expire."

#: src/admin/panels/SettingsPanel.js
msgid "Cleanup permanently removes expired details, while long-term totals remain available until their own retention window ends."
msgstr "Cleanup permanently removes expired details, while long-term totals remain available until their own retention window ends."

#: src/admin/panels/SettingsPanel.js
msgid "Automatic cleanup frequency"
msgstr "Automatisk oprydningsfrekvens"

#: src/admin/panels/SettingsPanel.js
msgid "Defines how often WordPress checks for expired analytics data."
msgstr "Defines how often WordPress checks for expired analytics data."

#: src/admin/panels/SettingsPanel.js
msgid "Exclusions"
msgstr "Udelukkelser"

#: src/admin/panels/SettingsPanel.js
msgid "Select roles to exclude from tracking. Select all roles to ignore all logged-in users."
msgstr "Vælg roller, der skal udelukkes fra sporing. Vælg alle roller for at ignorere alle indloggede brugere."

#: src/admin/panels/SettingsPanel.js
msgid "No roles available."
msgstr "Ingen roller tilgængelige."

#: src/admin/panels/SettingsPanel.js
msgid "Excluded paths"
msgstr "Udelukkede stier"

#. translators: 1: example page path, 2: example page path below the first one.
#: src/admin/panels/SettingsPanel.js
msgid "One page path per line, for example %1$s. Letter case, a trailing slash and the query string are ignored. There is no wildcard: %1$s does not exclude %2$s."
msgstr "Én sidesti pr. linje, for eksempel %1$s. Store og små bogstaver, en afsluttende skråstreg og forespørgselsstrengen ignoreres. Der er ingen jokertegn: %1$s udelukker ikke %2$s."

#: src/admin/panels/SettingsPanel.js
msgid "Listed pages are no longer counted after you save. Statistics already recorded do not change."
msgstr "Sider på listen tælles ikke længere, når du har gemt. Allerede registrerede statistikker ændres ikke."

#: src/admin/panels/SettingsPanel.js
msgid "Debug"
msgstr "Fejlfinding"

#: src/admin/panels/SettingsPanel.js
msgid "Enable diagnostic output for troubleshooting tracking events, realtime visitor detection, and REST payloads in the browser console and wp-content/debug.log."
msgstr "Aktivér diagnostisk output til fejlfinding af sporingshændelser, realtidsregistrering af besøgende og REST-payloads i browserkonsollen og wp-content/debug.log."

#: src/admin/panels/SettingsPanel.js
msgid "Debug mode"
msgstr "Fejlfindingstilstand"

#: src/admin/panels/SettingsPanel.js
msgid "Writes detailed diagnostic logs to the console and to wp-content/debug.log when WordPress debug logging is enabled."
msgstr "Skriver detaljerede diagnosticeringslogs til konsollen og til wp-content/debug.log, når WordPress-fejllogning er aktiveret."

#: src/admin/panels/SettingsPanel.js
msgid "Cleanup actions"
msgstr "Oprydningshandlinger"

#: src/admin/panels/SettingsPanel.js
msgid "Run retention cleanup immediately to remove only data older than the configured retention window."
msgstr "Kør opbevaringsoprydning med det samme for kun at fjerne data, der er ældre end det konfigurerede opbevaringsvindue."

#: src/admin/panels/SettingsPanel.js
msgid "Run cleanup now"
msgstr "Kør oprydning nu"

#: src/admin/panels/SettingsPanel.js
msgid "Delete plugin tables on uninstall"
msgstr "Slet plugintabeller ved afinstallation"

#: src/admin/panels/SettingsPanel.js
msgid "When enabled, uninstalling BimBeau Privacy Analytics drops all plugin analytics tables from the WordPress database."
msgstr "Når dette er aktiveret, sletter afinstallation af BimBeau Privacy Analytics alle pluginnets analysetabeller fra WordPress-databasen."

#: src/admin/panels/SettingsPanel.js
msgid "Sensitive actions"
msgstr "Følsomme handlinger"

#: src/admin/panels/SettingsPanel.js
msgid "Remove all aggregate KPI analytics, visitor-detail analytics, and raw log entries."
msgstr "Fjern alle aggregerede KPI-analyser, analyser med besøgsdetaljer og rå logposter."

#: src/admin/panels/SettingsPanel.js
msgid "Delete all analytics data"
msgstr "Slet alle analysedata"

#: src/admin/panels/SettingsPanel.js
msgid "Referring site icons"
msgstr "Henvisende websteder"

#: src/admin/panels/SettingsPanel.js
msgid "Display referring site favicons"
msgstr "Vis henvisningsfavikoner"

#: src/admin/panels/SettingsPanel.js
msgid "Allows BimBeau Privacy Analytics to retrieve referring site favicons, validate them on the server, and display locally cached copies in reports."
msgstr "Tillad BimBeau Privacy Analytics at kontakte henvisningsdomæner, hente validerede ikoner på serversiden og vise cachelagrede lokale kopier i rapporter."

#: src/admin/panels/SettingsPanel.js
msgid "When disabled, a local generic icon is displayed and no referrer domain is contacted for favicons."
msgstr "Når den er deaktiveret, vises et lokalt generisk ikon, og der kontaktes ikke noget referer-domæne for favicons."

#: src/admin/panels/SettingsPanel.js
msgid "Configuration assistant"
msgstr "Konfigurationsassistent"

#: src/admin/panels/SettingsPanel.js
msgid "Restart the assistant from the first step to review the plugin's main settings. Your current settings are preserved and can be changed during the different steps."
msgstr "Genstart assistenten fra det første trin for at gennemgå pluginets vigtigste indstillinger. Dine nuværende indstillinger bevares og kan ændres under de forskellige trin."

#: src/admin/panels/SettingsPanel.js
msgid "Restart the assistant"
msgstr "Genstart assistenten"

#: src/admin/panels/SettingsPanel.js
msgid "Save settings"
msgstr "Gem indstillinger"

#: src/admin/panels/SettingsPanel.js
msgid "Save"
msgstr "Gem"

#: src/admin/panels/SettingsPanel.js
msgid "Confirm data purge"
msgstr "Bekræft sletning af data"

#: src/admin/panels/SettingsPanel.js
msgid "This action permanently removes all stored analytics and raw logs. Settings remain unchanged."
msgstr "Denne handling fjerner permanent alle gemte analysedata og rå logs. Indstillinger forbliver uændrede."

#: src/admin/panels/SettingsPanel.js
msgid "I confirm that I want to permanently purge all analytics data."
msgstr "Jeg bekræfter, at jeg vil slette alle analysedata permanent."

#: src/admin/panels/SettingsPanel.js
msgid "Cancel"
msgstr "Annuller"

#: src/admin/panels/SettingsPanel.js
msgid "Purge now"
msgstr "Slet nu"

#: src/admin/panels/SettingsPanel.js
msgid "Confirm aggregated data purge"
msgstr "Bekræft sletning af aggregerede data"

#: src/admin/panels/SettingsPanel.js
msgid "This action runs retention cleanup immediately and removes only rows older than the configured window."
msgstr "Denne handling kører opbevaringsoprydning med det samme og fjerner kun rækker, der er ældre end det konfigurerede vindue."

#: src/admin/panels/SettingsPanel.js
msgid "I confirm that I want to purge only data older than the configured retention window."
msgstr "Jeg bekræfter, at jeg kun vil slette data, der er ældre end det konfigurerede opbevaringsvindue."

